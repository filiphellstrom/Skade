{
  "expo": {
    "name": "Skade",
    "slug": "skade",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "skade",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.skade.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSSupportsLiveActivities": true
      },
      "appleTeamId": "372JXBLW33"
    },
    "android": {
      "package": "com.skade.app"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "@bacons/apple-targets",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Skade använder dina bilder när du väljer en profilbild, en bild på din hund eller en bild av ett dokument.",
          "cameraPermission": "Skade använder kameran när du fotograferar din hund eller ett dokument, till exempel din vapenlicens.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Skade använder din ungefärliga position när du startar en jaktdag och ett drev, för att hämta vädret från SMHI till drevet. Positionen avrundas till ungefär en kilometer."
        }
      ],
      "./plugins/utan-push.js"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6be1dc10-3a72-4d5a-8f9d-8a96b2cdd457"
      }
    },
    "owner": "filiphellstrom"
  }
}
